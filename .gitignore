# Prerequisites
*.d
# ...but not systemd drop-in directories, which end in .d too. Without this the local node's
# dist/linux/systemd/system/euclid-wrk.service.d/local-node.conf was silently never committed, and
# the release's packaging step failed on a file that existed only on the machine that wrote it.
# Negated as a directory: git cannot re-include a file whose parent directory is excluded.
!*.service.d/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Cmake
**/CMakeCache.txt
**/CMakeFiles
**/cmake-build-debug
**/cmake-build-release
**/cmake-build-*
**/Makefile
**/*.cbp
**/install_manifest.txt
**/_deps

# Ninja
**/.ninja*
**/*.ninja

# Vcpkg
vcpkg_installed

# Testing
Testing/

# Idea
.idea
**/*.iml

# Claude
.claude/settings.local.json

# Fuzzing
#
# The seed corpus under fuzz/corpus is checked in - those are the inputs somebody thought worth
# writing down, and fuzz/smoke.sh runs over them. What libFuzzer *finds* is not: it names new
# inputs after their SHA-1, and a few seconds of smoke produces hundreds of them. smoke.sh keeps
# them out by writing to a scratch corpus under the build directory, but a target run by hand can
# still be pointed straight at fuzz/corpus, so the forty-hex-digit names are ignored outright.
fuzz/corpus/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]

# A build directory that is not called cmake-build-* (the sanitizer build in CI, say).
fuzz-corpus/

# Generated from LICENSE by dist/win32/msi/license-to-rtf.ps1 for the MSI licence dialog.
dist/win32/msi/license.rtf
dist/win32/msi/banner.bmp
dist/win32/msi/dialog.bmp

# Locally built installers - dist/win32/msi/README.md explains how to make them.
dist/out/
