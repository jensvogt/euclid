<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows package for euclid-cli on its own.

  The server package already contains the CLI, because a server is administered from the machine it
  runs on. This one is for the machine it does not: a workstation, a build agent, anything that
  talks to a euclid somewhere else and has no business installing nineteen module binaries and a
  service to do it.

  Its own UpgradeCode, so the two packages are separate products and neither upgrades or uninstalls
  the other. They can sit side by side: this one installs into euclid-cli\ and puts that on the
  PATH, where the server package leaves its copy in euclid\bin, which is not on anybody's PATH.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <?ifndef Version ?>
    <?define Version = "1.0.0" ?>
    <?endif?>
    <?ifndef BuildDir ?>
    <?define BuildDir = "..\..\..\cmake-build-release" ?>
    <?endif?>
    <?ifndef SrcDir ?>
    <?define SrcDir = "..\..\.." ?>
    <?endif?>

    <!-- Generated from LICENSE by license-to-rtf.ps1 - see euclid.wxs. -->
    <!-- The banner across the top of most pages, and the background of the welcome and
         finish pages. Drawn from the branding mark by make-ui-images.ps1, at the two sizes
         Windows Installer will not scale - see that script. -->
    <?ifndef BannerBmp ?>
    <?define BannerBmp = "$(SrcDir)\dist\win32\msi\banner.bmp" ?>
    <?endif?>
    <?ifndef DialogBmp ?>
    <?define DialogBmp = "$(SrcDir)\dist\win32\msi\dialog.bmp" ?>
    <?endif?>

    <?ifndef LicenseRtf ?>
    <?define LicenseRtf = "$(SrcDir)\dist\win32\msi\license.rtf" ?>
    <?endif?>

    <Package Name="Euclid CLI"
             Manufacturer="Jens Vogt"
             Version="$(Version)"
             Language="1033"
             Scope="perMachine"
             Compressed="yes"
             InstallerVersion="500"
             UpgradeCode="c4e1b9a7-5d62-4f8b-9c3a-2e7d6f1b8a40">

        <SummaryInformation Description="Euclid command line interface" Manufacturer="Jens Vogt" />

        <MajorUpgrade AllowSameVersionUpgrades="yes"
                      DowngradeErrorMessage="A newer version of the Euclid CLI is already installed. Uninstall it first if you mean to go back." />

        <MediaTemplate EmbedCab="yes" />

        <!-- Welcome, licence, progress - and no install-directory page, unlike the server
             package. There is one file here and it goes on the PATH; where it sits is a
             question with no consequences, and a wizard that asks anyway is one more page
             between somebody and the command they came for. -->
        <ui:WixUI Id="WixUI_Minimal" />
        <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
        <WixVariable Id="WixUIBannerBmp" Value="$(BannerBmp)" />
        <WixVariable Id="WixUIDialogBmp" Value="$(DialogBmp)" />

        <Icon Id="euclid.ico" SourceFile="$(SrcDir)\dist\branding\favicon.ico" />
        <Property Id="ARPPRODUCTICON" Value="euclid.ico" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/jensvogt/euclid" />

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="euclid-cli">
                <Directory Id="BINFOLDER" Name="bin">
                    <Component Id="EuclidCli">
                        <File Id="euclid_cli.exe" Source="$(BuildDir)\bin\euclid-cli.exe" KeyPath="yes" />

                        <!-- Appended to the machine PATH, and taken off again on uninstall, by
                             Windows Installer itself. The NSIS package shipped a PowerShell script
                             to do this - see the comments in the euclid-path.ps1 it replaced for
                             how many ways there are to destroy a PATH by editing it from an
                             installer. None of them are available here: the value is a row in a
                             table and the removal is part of the uninstall transaction.

                             Part="last" appends rather than replacing, and System="yes" makes it
                             the machine's PATH rather than the installing administrator's - a CLI
                             installed for everyone should be on everyone's PATH. -->
                        <Environment Id="PathEntry"
                                     Name="PATH"
                                     Value="[BINFOLDER]"
                                     Action="set"
                                     Part="last"
                                     System="yes"
                                     Permanent="no" />
                    </Component>
                </Directory>
            </Directory>
        </StandardDirectory>

    </Package>
</Wix>
