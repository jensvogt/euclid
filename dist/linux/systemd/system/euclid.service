[Unit]
Description=Euclid Service Cloud Manager
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
RuntimeDirectory=euclid
RuntimeDirectoryMode=0755
ExecStart=/usr/local/euclid/bin/euclid-manager --loglevel info --config /usr/local/euclid/etc/euclid.json
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
