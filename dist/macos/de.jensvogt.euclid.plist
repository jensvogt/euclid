<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>KeepAlive</key>
        <false/>
        <key>Label</key>
        <string>de.jensvogt.euclid</string>
        <key>ProcessType</key>
        <string>Background</string>
        <key>Program</key>
        <string>/usr/local/euclid/bin/euclid-mgr</string>
        <key>ProgramArguments</key>
        <array>
            <string>--loglevel info</string>
            <string>--config</string>
            <string>/usr/local/euclid/etc/euclid.json</string>
        </array>
        <key>StandardOutPath</key>
        <string>/usr/local/euclid/log/launchd-stdout.log</string>
        <key>StandardErrorPath</key>
        <string>/usr/local/euclid/log/launchd-stderr.log</string>
        <key>RunAtLoad</key>
        <true/>
    </dict>
</plist>
