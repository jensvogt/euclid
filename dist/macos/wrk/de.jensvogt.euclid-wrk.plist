<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The launchd counterpart of dist/linux/systemd/system/euclid-wrk.service, and its own job rather
    than part of de.jensvogt.euclid's for the reason the worker has its own package at all: a worker
    host is deliberately not a euclid host. It runs no modules, holds no database credentials and has
    nothing listening.

    Not loaded by unpacking the tarball. Copy it to /Library/LaunchDaemons, the only directory
    launchd reads system daemons from, where it has to be owned by root with mode 0644 or launchd
    refuses the job. See "The worker on its own" in README.md for the ordered steps.

    Note for anyone editing the comments here: an XML comment may not contain two consecutive
    hyphens, so the worker's command line options are named without their leading pair throughout.
-->
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>de.jensvogt.euclid-wrk</string>

        <!-- Not root, which is the whole point of the account this names. The applications a worker
             runs are somebody else's code, forked from this process and inheriting what it is
             allowed to do, so the process that forks them has no business being root. There is no
             ProtectSystem=strict on macOS to limit the damage if it were.

             launchd will not load this job until the account exists, which the install steps create,
             and a job that refuses to load says so in "launchctl print". That is a better failure
             than the alternative: a plist naming no user runs as root and says nothing. -->
        <key>UserName</key>
        <string>_euclid-wrk</string>
        <key>GroupName</key>
        <string>_euclid-wrk</string>

        <!-- The unit file's Restart=always. ThrottleInterval is left at launchd's default of ten
             seconds rather than matched to its RestartSec=1: a worker that cannot start is usually
             one waiting for an endpoint or a login, and the master re-places its work after one
             lease period regardless, so respawning nine seconds sooner buys nothing and fills the
             log with the same message. -->
        <key>KeepAlive</key>
        <true/>
        <key>RunAtLoad</key>
        <true/>
        <key>ProcessType</key>
        <string>Background</string>

        <!-- ProgramArguments carries argv in full, the program's own path included, and there is
             deliberately no Program key beside it. With Program set and ProgramArguments starting at
             the first real argument, launchd passes that argument as argv[0], where a program
             expects its own name and an option parser skips it, so the option is read by nobody.

             The configuration named here is emphatically not /usr/local/euclid/etc/euclid.json. That
             is the manager's, and it holds euclid.modules.eam.jwt-secret; a worker refuses to start
             if it finds that key, because anything holding it can mint a bearer token for any
             principal in the installation, including admin, offline and unaudited. See
             docs/worker-nodes.md section 3.2.

             The endpoint, the node name and the labels belong in that configuration file rather than
             here, so that changing where this worker reports to is not an edit to a file the next
             upgrade overwrites. The log level too, which is why no loglevel option is passed. -->
        <key>ProgramArguments</key>
        <array>
            <string>/usr/local/euclid/bin/euclid-wrk</string>
            <string>--config</string>
            <string>/usr/local/euclid/etc/euclid-wrk.json</string>
        </array>

        <!-- launchd's own capture of anything the worker writes to the console before its logger is
             up: a configuration that will not parse, a jwt-secret that must not be there, no
             credentials. The worker's real log is euclid.logging.dir in the configuration. Both land
             under the state directory because that is the one place _euclid-wrk can write. -->
        <key>StandardOutPath</key>
        <string>/usr/local/var/euclid-wrk/launchd-stdout.log</string>
        <key>StandardErrorPath</key>
        <string>/usr/local/var/euclid-wrk/launchd-stderr.log</string>

        <!-- A worker stops its own instances on an orderly shutdown, but a JVM given SIGTERM may
             take a moment to finish what it is doing. The unit file's TimeoutStopSec=60; launchd's
             equivalent is the grace period before it escalates to SIGKILL. -->
        <key>ExitTimeOut</key>
        <integer>60</integer>
    </dict>
</plist>
