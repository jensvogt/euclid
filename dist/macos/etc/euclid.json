{
  "euclid": {
    "region": "eu-central-1",
    "account-ids": [
      "000000000000"
    ],
    "namespaces": [
      "development",
      "integration",
      "production"
    ],
    "data-dir": "/usr/local/euclid/data",
    "temp-dir": "/usr/local/euclid/data/tmp",
    "backup-dir": "/usr/local/euclid/data/backup",
    "json": {
      "pretty": false
    },
    "dockerized": false,
    "magic-file": "/usr/local/euclid/etc/magic.mgc",
    "autoload": {
      "active": true,
      "file": "/usr/local/euclid/init/01_init.json",
      "dir": "/usr/local/euclid/init"
    },
    "gateway": {
      "active": true,
      "http": {
        "host": "localhost",
        "address": "::",
        "port": 5566,
        "max-queue": 8,
        "max-thread": 64,
        "max-body": 536870912,
        "timeout": 300
      },
      "tls": {
        "enabled": false,
        "cert-file": "",
        "key-file": ""
      },
      "websocket": {
        "enabled": true,
        "max-message-size": 1048576,
        "idle-timeout-seconds": 300,
        "max-outbox-frames": 256,
        "max-outbox-bytes": 8388608
      },
      "event-socket-path": "/var/run/euclid/euclid-gateway-events.sock"
    },
    "modules": {
      "eam": {
        "active": true,
        "name": "eam",
        "socketPath": "/var/run/euclid/euclid-eam.sock",
        "executable": "/usr/local/euclid/bin/euclid-eam",
        "minInstances": 1,
        "maxInstances": 2,
        "threads": 2,
        "data-dir": "/usr/local/euclid/data/access",
        "jwt-secret": "changeme-set-a-real-secret-in-production"
      },
      "esm": {
        "active": true,
        "name": "esm",
        "socketPath": "/var/run/euclid/euclid-esm.sock",
        "executable": "/usr/local/euclid/bin/euclid-esm",
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "data-dir": "/usr/local/euclid/data/esm",
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 2,
        "counter-period": 60,
        "sync-period": 3600,
        "archive-timeout": 300
      },
      "eqs": {
        "active": true,
        "name": "eqs",
        "socketPath": "/var/run/euclid/euclid-eqs.sock",
        "executable": "/usr/local/euclid/bin/euclid-eqs",
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "monitoring-period": 300,
        "reset-period": 30,
        "counter-period": 30,
        "receive-poll": 1000,
        "priority-weights": {
          "high": 4,
          "middle": 2,
          "low": 1
        },
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 8
      },
      "ens": {
        "active": false,
        "name": "ens",
        "socketPath": "/var/run/euclid/euclid-ens.sock",
        "executable": "/usr/local/euclid/bin/euclid-ens",
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 2
      },
      "emo": {
        "active": true,
        "name": "emo",
        "socketPath": "/var/run/euclid/euclid-emo.sock",
        "executable": "/usr/local/euclid/bin/euclid-emo",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2,
        "average-period": 300,
        "rollup-hour-period": 600,
        "rollup-day-period": 3600,
        "cpu-usage-period": 60,
        "queue-count.period": 60,
        "bucket-count.period": 60,
        "topic-count.period": 60,
        "database-size-period": 300,
        "retention": {
          "raw": 7,
          "hour": 90,
          "day": 1825
        }
      },
      "ekm": {
        "active": true,
        "name": "ekm",
        "socketPath": "/var/run/euclid/euclid-ekm.sock",
        "executable": "/usr/local/euclid/bin/euclid-ekm",
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 2,
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        }
      },
      "emm": {
        "active": true,
        "name": "emm",
        "socketPath": "/var/run/euclid/euclid-emm.sock",
        "executable": "/usr/local/euclid/bin/euclid-emm",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2
      },
      "eap": {
        "active": true,
        "name": "eap",
        "socketPath": "/var/run/euclid/euclid-eap.sock",
        "executable": "/usr/local/euclid/bin/euclid-eap",
        "socket-dir": "/var/run/euclid",
        "data-dir": "/usr/local/euclid/data/eap",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2
      },
      "ets": {
        "active": true,
        "name": "ets",
        "socketPath": "/var/run/euclid/euclid-ets.sock",
        "executable": "/usr/local/euclid/bin/euclid-ets",
        "socket-dir": "/var/run/euclid",
        "data-dir": "/usr/local/euclid/data/ets",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2,
        "inline-max": 67108864,
        "part-size": 8388608,
        "directories": [
          "incoming/mix",
          "incoming/split",
          "feedback"
        ]
      },
      "lambda": {
        "active": true,
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "lifetime": 3600,
        "data-dir": "/usr/local/euclid/data/lambda",
        "remove-period": 300,
        "counter-period": 300,
        "log-retention-period": 1,
        "private-port": 8080,
        "max-invocation-count": 3,
        "invocation-timeout": 5,
        "runtime": {
          "java11": "public.ecr.aws/lambda/java:11",
          "java17": "public.ecr.aws/lambda/java:17",
          "java21": "public.ecr.aws/lambda/java:21",
          "java25": "public.ecr.aws/lambda/java:25",
          "java26": "public.ecr.aws/lambda/java:26",
          "python3-9": "public.ecr.aws/lambda/python:3.9",
          "python3-10": "public.ecr.aws/lambda/python:3.10",
          "python3-11": "public.ecr.aws/lambda/python:3.11",
          "python3-12": "public.ecr.aws/lambda/python:3.12",
          "python3-13": "public.ecr.aws/lambda/python:3.13",
          "nodejs18-x": "public.ecr.aws/lambda/nodejs:18",
          "nodejs20-x": "public.ecr.aws/lambda/nodejs:20",
          "nodejs22-x": "public.ecr.aws/lambda/nodejs:22",
          "provided-al2": "public.ecr.aws/lambda/provided:al2",
          "provided-al2023": "public.ecr.aws/lambda/provided:al2023",
          "provided-latest": "public.ecr.aws/lambda/provided:latest",
          "go": "public.ecr.aws/lambda/provided:al2023"
        }
      },
      "transfer": {
        "active": true,
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "bucket": "transfer-server",
        "data-dir": "/usr/local/euclid/data/transfer",
        "user-pool-id": "eu-central-1_oGsr6fJ8F",
        "monitoring-period": 300,
        "directories": [
          "incoming/mix",
          "incoming/split",
          "feedback"
        ],
        "ftp": {
          "pasv-min": 6000,
          "pasv-max": 6100,
          "port": 2121,
          "address": "0.0.0.0"
        },
        "sftp": {
          "host-key": "/usr/local/euclid/etc/ssh_host_key",
          "pasv-min": 6000,
          "pasv-max": 6100,
          "port": 2222,
          "address": "0.0.0.0"
        }
      },
      "cognito": {
        "active": true,
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "monitoring-period": 300
      },
      "dynamodb": {
        "active": true,
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "data-dir": "/usr/local/euclid/data/dynamodb",
        "monitoring-period": 300,
        "worker-period": 300
      },
      "secretsmanager": {
        "active": true,
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "monitoring-period": 300,
        "worker-period": 300
      },
      "ssm": {
        "active": true,
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "monitoring-period": 300,
        "worker-period": 300,
        "remove-period": 300
      },
      "application": {
        "active": true,
        "data-dir": "/usr/local/euclid/data/application",
        "runtime": {
          "java11": "alpine/java:11-jdk",
          "java17": "alpine/java:17-jdk",
          "java21": "alpine/java:21-jdk",
          "java25": "alpine/java:25-jdk",
          "java26": "alpine/java:26-jdk",
          "python3-9": "public.ecr.aws/lambda/python:3.9",
          "python3-10": "public.ecr.aws/lambda/python:3.10",
          "python3-11": "public.ecr.aws/lambda/python:3.11",
          "python3-12": "public.ecr.aws/lambda/python:3.12",
          "python3-13": "public.ecr.aws/lambda/python:3.13",
          "nodejs18-x": "public.ecr.aws/lambda/nodejs:18",
          "nodejs20-x": "public.ecr.aws/lambda/nodejs:20",
          "nodejs22-x": "public.ecr.aws/lambda/nodejs:22",
          "provided-al2": "public.ecr.aws/lambda/provided:al2",
          "provided-al2023": "public.ecr.aws/lambda/provided:al2023",
          "provided-latest": "public.ecr.aws/lambda/provided:latest",
          "go": "public.ecr.aws/lambda/provided:al2023"
        },
        "backup": {
          "active": true,
          "cron": "0 0 0 * * ?",
          "count": 5
        },
        "monitoring-period": 300,
        "watchdog-period": 300,
        "log-server": false,
        "log-server-port": 4568
      }
    },
    "docker": {
      "active": true,
      "network-mode": "local",
      "network-name": "local",
      "default": {
        "memory-size": 512,
        "temp-size": 10240
      },
      "container": {
        "port": 8080,
        "maxWaitTime": 5,
        "checkTime": 500
      },
      "socket": "/var/run/docker.sock"
    },
    "scaling": {
      "scale-down-idle-seconds": 60
    },
    "monitoring": {
      "active": true,
      "average-period": 300,
      "cpu-usage-period": 60,
      "rollup-hour-period": 600,
      "rollup-day-period": 3600,
      "retention": {
        "raw": 7,
        "hour": 90,
        "day": 1825
      }
    },
    "mongodb": {
      "active": true,
      "name": "euclid",
      "host": "localhost",
      "port": 27017,
      "user": "root",
      "password": "password",
      "pool-size": 256
    },
    "frontend": {
      "active": true,
      "address": "::",
      "port": 4567,
      "workers": 20,
      "timeout": 900,
      "doc-root": "/usr/local/euclid/frontend"
    },
    "logging": {
      "file-active": false,
      "console-active": true,
      "websocket-active": true,
      "websocket-port": 4569,
      "level": "info",
      "dir": "/usr/local/euclid/log",
      "prefix": "euclid",
      "file-size": 10485760,
      "file-count": 5
    },
    "eventbus": {
      "notify-interval-ms": 100,
      "subscription-cache-seconds": 0
    }
  }
}
