{
  "euclid": {
    "region": "eu-central-1",
    "account-ids": [
      "000000000000"
    ],
    "namespaces": [
      "development",
      "integration",
      "production"
    ],
    "data-dir": "/usr/local/euclid/data",
    "temp-dir": "/usr/local/euclid/data/tmp",
    "magic-file": "/usr/local/euclid/etc/magic.mgc",
    "gateway": {
      "http": {
        "host": "localhost",
        "port": 5566,
        "max-thread": 64,
        "max-body": 536870912
      },
      "tls": {
        "enabled": false,
        "cert-file": "",
        "key-file": ""
      },
      "websocket": {
        "enabled": true,
        "max-message-size": 1048576,
        "idle-timeout-seconds": 300,
        "max-outbox-frames": 256,
        "max-outbox-bytes": 8388608
      },
      "event-socket-path": "/var/run/euclid/euclid-gateway-events.sock"
    },
    "modules": {
      "eam": {
        "active": true,
        "name": "eam",
        "socketPath": "/var/run/euclid/euclid-eam.sock",
        "executable": "/usr/local/euclid/bin/euclid-eam",
        "minInstances": 1,
        "maxInstances": 2,
        "threads": 2,
        "jwt-secret": "changeme-set-a-real-secret-in-production"
      },
      "esm": {
        "active": true,
        "name": "esm",
        "socketPath": "/var/run/euclid/euclid-esm.sock",
        "executable": "/usr/local/euclid/bin/euclid-esm",
        "data-dir": "/usr/local/euclid/data/esm",
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 2
      },
      "eqs": {
        "active": true,
        "name": "eqs",
        "socketPath": "/var/run/euclid/euclid-eqs.sock",
        "executable": "/usr/local/euclid/bin/euclid-eqs",
        "priority-weights": {
          "high": 4,
          "middle": 2,
          "low": 1
        },
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 8
      },
      "ens": {
        "active": false,
        "name": "ens",
        "socketPath": "/var/run/euclid/euclid-ens.sock",
        "executable": "/usr/local/euclid/bin/euclid-ens",
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 2
      },
      "emo": {
        "active": true,
        "name": "emo",
        "socketPath": "/var/run/euclid/euclid-emo.sock",
        "executable": "/usr/local/euclid/bin/euclid-emo",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2,
        "average-period": 300,
        "rollup-hour-period": 600,
        "rollup-day-period": 3600,
        "cpu-usage-period": 60,
        "queue-count-period": 60,
        "bucket-count-period": 60,
        "topic-count-period": 60,
        "database-size-period": 300,
        "retention": {
          "raw": 7,
          "hour": 90,
          "day": 1825
        }
      },
      "ekm": {
        "active": true,
        "name": "ekm",
        "socketPath": "/var/run/euclid/euclid-ekm.sock",
        "executable": "/usr/local/euclid/bin/euclid-ekm",
        "minInstances": 1,
        "maxInstances": 4,
        "threads": 2
      },
      "emm": {
        "active": true,
        "name": "emm",
        "socketPath": "/var/run/euclid/euclid-emm.sock",
        "executable": "/usr/local/euclid/bin/euclid-emm",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2
      },
      "ees": {
        "active": true,
        "name": "ees",
        "socketPath": "/var/run/euclid/euclid-ees.sock",
        "executable": "/usr/local/euclid/bin/euclid-ees",
        "minInstances": 1,
        "maxInstances": 2,
        "threads": 8
      },
      "eap": {
        "active": true,
        "name": "eap",
        "socketPath": "/var/run/euclid/euclid-eap.sock",
        "executable": "/usr/local/euclid/bin/euclid-eap",
        "socket-dir": "/var/run/euclid",
        "data-dir": "/usr/local/euclid/data/eap",
        "minInstances": 1,
        "maxInstances": 32,
        "threads": 2,
        "http-port-min": 9000,
        "http-port-max": 9999,
        "credentials-ttl-seconds": 3600
      },
      "ets": {
        "active": true,
        "name": "ets",
        "socketPath": "/var/run/euclid/euclid-ets.sock",
        "executable": "/usr/local/euclid/bin/euclid-ets",
        "socket-dir": "/var/run/euclid",
        "data-dir": "/usr/local/euclid/data/ets",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2,
        "inline-max": 67108864,
        "part-size": 8388608,
        "host-key": "/usr/local/euclid/etc/ssh_host_key",
        "ftp-executable": "/usr/local/euclid/bin/euclid-ftp",
        "sftp-executable": "/usr/local/euclid/bin/euclid-sftp"
      },
      "eag": {
        "active": true,
        "name": "eag",
        "socketPath": "/var/run/euclid/euclid-eag.sock",
        "executable": "/usr/local/euclid/bin/euclid-eag",
        "minInstances": 1,
        "maxInstances": 1,
        "threads": 2,
        "port": 8080,
        "proxy-threads": 8,
        "refresh-seconds": 5,
        "basic-auth-cache-seconds": 60,
        "listeners": {
          "development": {
            "port": 8080
          },
          "integration": {
            "port": 8081
          },
          "production": {
            "port": 80
          }
        }
    },
    "scaling": {
      "scale-down-idle-seconds": 60
    },
    "monitoring": {
      "cpu-usage-period": 60
    },
    "mongodb": {
      "name": "euclid",
      "host": "localhost",
      "port": 27017,
      "user": "root",
      "password": "password",
      "pool-size": 256
    },
    "logging": {
      "file-active": false,
      "console-active": true,
      "level": "info",
      "dir": "/usr/local/euclid/log",
      "prefix": "euclid"
    },
    "eventbus": {
      "notify-interval-ms": 100,
      "subscription-cache-seconds": 0
    }
  }
}
