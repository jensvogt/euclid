<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>de.jensvogt.euclid.examples</groupId>
    <artifactId>euclid-inbox-app</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>euclid-inbox-app</name>
    <description>Example euclid application: watches a bucket through a queue and logs what arrives</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <euclid-jdk.version>0.1.9</euclid-jdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.jensvogt</groupId>
            <artifactId>euclid-jdk</artifactId>
            <version>${euclid-jdk.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>euclid-inbox-app</finalName>
        <plugins>
            <!-- One self-contained jar, because that is what a euclid JAVA application is: the
                 manager copies a single object out of a bucket and runs "java -jar" on it, with
                 no classpath to assemble and no dependencies on the host. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.jensvogt.euclid.examples.inbox.InboxApplication</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
